<resources>
    <style name="Theme.EB3A" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/fg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="materialButtonStyle">@style/Widget.EB3A.Button</item>
    </style>

    <style name="Widget.EB3A.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Widget.EB3A.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/fg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Widget.EB3A.Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Text.Brand" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Watts" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">84sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
